# Docker Compose raw env format: do not wrap values in quotes.
# Provision this file from your secret manager; never commit runtime.env.
HITEK_SUPABASE_URL=https://your-project.supabase.co
HITEK_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Managed onboarding is automatic with HITEK_SUPABASE_URL; set explicitly for other identity adapters.
HITEK_MANAGED_SERVICE=1
OMB_SIGNIN_EMAILS=owner@example.com
OMB_SIGNIN_MEMBER_EMAILS=staff@example.com
HITEK_MCP_URL=https://crm.example.com/mcp
HITEK_MCP_OAUTH_CLIENT_ID=REPLACE_WITH_REGISTERED_CLIENT_ID
HITEK_MCP_OAUTH_SCOPES=mcp
HITEK_CONNECT_LABEL=HITEK CRM
# Configure a dealer-scoped provider/gateway credential here
# only when the selected engine supports its provider environment variables.
# Never place a platform-wide provider key or Supabase service-role key here.
